PROFILE=local
CACHE_TTL_SECONDS=20
REQUEST_TIMEOUT_SECONDS=5
FRONTEND_DIST=../frontend/dist

# SRE rollout: incident history, runbooks, alerting, push heartbeats.
INCIDENTS_DB_PATH=./aisaac_incidents.db
RUNBOOKS_DIR=../runbooks
RESEND_API_KEY=
ALERT_FROM_EMAIL=AIsaac <onboarding@resend.dev>
ALERT_TO_EMAIL=
# Shared secret apps must send as the X-Internal-Secret header when
# pushing a heartbeat to POST /internal/report. Required for that
# endpoint to accept anything -- it refuses all requests when unset.
INTERNAL_REPORT_SECRET=
STALE_REPORT_AFTER_HOURS=26
