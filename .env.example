PROFILE=local
CACHE_TTL_SECONDS=20
REQUEST_TIMEOUT_SECONDS=5
FRONTEND_DIST=../frontend/dist

# SRE rollout: incident history, runbooks, alerting, push heartbeats.
INCIDENTS_DB_PATH=./aisaac_incidents.db
RUNBOOKS_DIR=../runbooks
RESEND_API_KEY=
ALERT_FROM_EMAIL=AIsaac <onboarding@resend.dev>
ALERT_TO_EMAIL=
# Shared secret apps must send as the X-Internal-Secret header when
# pushing a heartbeat to POST /internal/report. Required for that
# endpoint to accept anything -- it refuses all requests when unset.
INTERNAL_REPORT_SECRET=
STALE_REPORT_AFTER_HOURS=26

# Fine-grained PAT, read-only, scoped to just the monitored repos:
# Contents, Metadata, Issues, Pull requests, Actions.
GITHUB_TOKEN=
GITHUB_CACHE_TTL_SECONDS=300

# Coms: push CI/PR/issue status via POST /internal/ci-report (same
# X-Internal-Secret gate as /internal/report), recorded as history and
# forwarded to ntfy.sh at most once per COMS_DEBOUNCE_MINUTES per app_id.
NTFY_TOPIC=
COMS_DEBOUNCE_MINUTES=10
CI_EVENTS_DB_PATH=./aisaac_ci_events.db

# Financial figures (Claude/Codex usage, Neon/Fly costs): pushed by external jobs to
# /internal/metrics/{source} (uses INTERNAL_REPORT_SECRET); reads need this token.
METRICS_DB_PATH=./aisaac_metrics.db
DASHBOARD_READ_TOKEN=

# Scoped read-only token for Portfolio Analysis's GET /api/v1/health/metrics
# (aggregates only), sent as X-Metrics-Token. Must equal Portfolio's METRICS_TOKEN.
# NOT Portfolio's APP_TOKEN. Unset = Portfolio metrics are skipped.
PORTFOLIO_METRICS_TOKEN=
